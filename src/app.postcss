@tailwind base;
@tailwind components;
@tailwind utilities;

h1 {
	@apply font-bold;
}

.chord-sheet {
	@apply p-1;
}

.chord-sheet .paragraph {
	@apply p-2 mb-4;
	orphans: 2;
	widows: 2;
}

.chord-sheet .row {
	@apply flex flex-row flex-wrap;
}

.chord-sheet .column {
	@apply mr-1 mt-1;
}

.chord-sheet .chord:after {
	content: '\200b';
}

.chord-sheet .chord {
	@apply cursor-pointer font-bold inline;
}

.chord-sheet .verse {
	@apply border-l-2 border-letkwet-400;
}

.chord-sheet .chorus {
	@apply border-l-2 border-green-400;
}

.chord-sheet .bridge {
	@apply border-l-2 border-purple-400;
}

.chord-sheet .comment {
	@apply text-gray-600 font-bold mb-0;
}
